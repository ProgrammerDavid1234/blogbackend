{
    "openapi": "3.0.0",
    "info": {
        "title": "NACOS KDU Blog API",
        "version": "1.0.0",
        "description": "Public API for the NACOS KDU Blog"
    },
    "servers": [
        {
            "url": "https://blogbackend-2cn4.onrender.com/api/v1",
            "description": "Production Server"
        },
        {
            "url": "http://localhost:5000/api/v1",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/home": {
            "get": {
                "tags": [
                    "Public: Home"
                ],
                "summary": "Get home page data",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "trending": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Post"
                                                    }
                                                },
                                                "featured": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Post"
                                                    }
                                                },
                                                "latest": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Post"
                                                    }
                                                },
                                                "announcements": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Post"
                                                    }
                                                },
                                                "upcomingEvents": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Event"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/posts": {
            "get": {
                "tags": [
                    "Public: Posts"
                ],
                "summary": "Get all posts",
                "parameters": [
                    {
                        "in": "query",
                        "name": "page",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "category",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Category ID"
                    },
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Search query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/posts/{idOrSlug}": {
            "get": {
                "tags": [
                    "Public: Posts"
                ],
                "summary": "Get single post",
                "parameters": [
                    {
                        "in": "path",
                        "name": "idOrSlug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/posts/{id}/view": {
            "post": {
                "tags": [
                    "Public: Posts"
                ],
                "summary": "Increment post view count",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/tags/{slug}/posts": {
            "get": {
                "tags": [
                    "Public: Tags"
                ],
                "summary": "Get posts by tag",
                "parameters": [
                    {
                        "in": "path",
                        "name": "slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/categories": {
            "get": {
                "tags": [
                    "Public: Categories"
                ],
                "summary": "Get all categories",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/categories/{slug}": {
            "get": {
                "tags": [
                    "Public: Categories"
                ],
                "summary": "Get single category",
                "parameters": [
                    {
                        "in": "path",
                        "name": "slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/categories/{slug}/posts": {
            "get": {
                "tags": [
                    "Public: Categories"
                ],
                "summary": "Get posts by category",
                "parameters": [
                    {
                        "in": "path",
                        "name": "slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/events": {
            "get": {
                "tags": [
                    "Public: Events"
                ],
                "summary": "Get events",
                "parameters": [
                    {
                        "in": "query",
                        "name": "when",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "upcoming",
                                "past"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/authors": {
            "get": {
                "tags": [
                    "Public: Authors"
                ],
                "summary": "Get all authors",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/authors/{id}": {
            "get": {
                "tags": [
                    "Public: Authors"
                ],
                "summary": "Get author profile and posts",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/search": {
            "get": {
                "tags": [
                    "Public: Search"
                ],
                "summary": "Global search",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/newsletter/subscribe": {
            "post": {
                "tags": [
                    "Public: Newsletter"
                ],
                "summary": "Subscribe to newsletter",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/settings": {
            "get": {
                "tags": [
                    "Admin: Settings"
                ],
                "summary": "Get site settings",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            },
            "put": {
                "tags": [
                    "Admin: Settings"
                ],
                "summary": "Update site settings (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/posts/{id}/feature": {
            "put": {
                "tags": [
                    "Admin: Posts"
                ],
                "summary": "Toggle post feature status (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/posts/{id}/trending": {
            "put": {
                "tags": [
                    "Admin: Posts"
                ],
                "summary": "Toggle post trending status (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/tags": {
            "get": {
                "tags": [
                    "Public: Tags"
                ],
                "summary": "Get all tags",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            },
            "post": {
                "tags": [
                    "Admin: Tags"
                ],
                "summary": "Create tag (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created"
                    }
                }
            }
        },
        "/tags/{id}": {
            "put": {
                "tags": [
                    "Admin: Tags"
                ],
                "summary": "Update tag (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Admin: Tags"
                ],
                "summary": "Delete tag (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/gallery": {
            "get": {
                "tags": [
                    "Public: Gallery"
                ],
                "summary": "Get gallery items",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            },
            "post": {
                "tags": [
                    "Admin: Gallery"
                ],
                "summary": "Upload gallery item (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "parameters": [
                    {
                        "in": "formData",
                        "name": "image",
                        "type": "file",
                        "description": "Image file"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created"
                    }
                }
            }
        },
        "/gallery/{id}": {
            "delete": {
                "tags": [
                    "Admin: Gallery"
                ],
                "summary": "Delete gallery item (Admin)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Post": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "excerpt": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "author": {
                        "$ref": "#/components/schemas/Author"
                    },
                    "category": {
                        "$ref": "#/components/schemas/Category"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "viewCount": {
                        "type": "integer"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Event": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "location": {
                        "type": "object"
                    }
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    }
                }
            },
            "Author": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "profileImage": {
                        "type": "string"
                    }
                }
            }
        }
    }
}